{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "athena-ros2": {
      "type": "stdio",
      "command": "bash",
      "args": ["${PLUGIN_ROOT}/scripts/dev_mcp.sh"],
      "cwd": "${PLUGIN_ROOT}"
    },
    "athena-aaa": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--project", "${PLUGIN_ROOT}", "--locked", "python", "${PLUGIN_ROOT}/aaa_server.py"],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
